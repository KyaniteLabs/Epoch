exports[`CLI -> dispatch contract > rejects bad option values before dispatch 1`] = `
{
  "add-business-days --start-date 2026-05-01 --days x": {
    "calls": [],
    "code": 1,
    "stderr": "Error: --days must be a number, got "x"",
  },
  "batch-record-actuals --entries nope": {
    "calls": [],
    "code": 1,
    "stderr": "Error: --entries must be valid JSON: Unexpected token 'o', "nope" is not valid JSON",
  },
  "critical-path --tasks {not json": {
    "calls": [],
    "code": 1,
    "stderr": "Error: --tasks must be valid JSON: Expected property name or '}' in JSON at position 1 (line 1 column 2)",
  },
  "get-pending-estimates --limit abc": {
    "calls": [],
    "code": 1,
    "stderr": "Error: --limit must be an integer, got "abc"",
  },
  "pert-estimate --most-likely 4 --pessimistic 12": {
    "calls": [],
    "code": 1,
    "stderr": "error: required option '--optimistic <n>' not specified",
  },
  "pert-estimate --optimistic abc --most-likely 4 --pessimistic 12": {
    "calls": [],
    "code": 1,
    "stderr": "Error: --optimistic must be a number, got "abc"",
  },
  "sprint-forecast --backlog-points 10 --velocity-history 5,abc": {
    "calls": [],
    "code": 1,
    "stderr": "Error: --velocity-history contains non-numeric value "abc"",
  },
  "wait-bound --clock-class fleet --cycles-k NaN": {
    "calls": [],
    "code": 1,
    "stderr": "Error: --cycles-k must be a number, got "NaN"",
  },
}
`;
