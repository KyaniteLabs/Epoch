{
  "name": "@kyanitelabs/epoch",
  "version": "0.1.0",
  "description": "Time Estimation MCP Server — 19 structured tools for PERT, COCOMO II, Monte Carlo, sprint forecasting, token-to-time mapping, cost estimation, schedule risk, and model comparison. Self-improving engine. MCP + CLI + REST API.",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "epoch": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "inspector": "npx @modelcontextprotocol/inspector node dist/index.js",
    "canary": "node canary-runner.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "time-estimation",
    "software-estimation",
    "pert",
    "cocomo",
    "monte-carlo-simulation",
    "llm-tools",
    "ai-agent",
    "sprint-planning",
    "project-management",
    "scheduling",
    "critical-path",
    "agile",
    "typescript",
    "token-cost",
    "cost-estimation",
    "schedule-risk",
    "reference-class-forecasting",
    "model-comparison",
    "self-improving"
  ],
  "author": "Kyanite Labs",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/KyaniteLabs/Epoch.git"
  },
  "dependencies": {
    "@hono/node-server": "^2.0.1",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "commander": "^14.0.3",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "hono": "^4.12.16",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.4",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^3.2.4",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
